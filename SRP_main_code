              function craftDevice(id) {
                  const recipe = craftingRecipes.find(r => r.id === id);

                  for (const ing of recipe.ingredients) {
                      const owned = stats.inventory[ing.name]?.count || 0;
                      if (owned < ing.amount) {
                          showNotification(`INSUFFICIENT MATERIALS: ${ing.name}`, "#ef4444");
                          return;
                      }
                  }

                  recipe.ingredients.forEach(ing => {
                      stats.inventory[ing.name].count -= ing.amount;
                  });

                  stats.crafted[id] = (stats.crafted[id] || 0) + 1;

                  if (!stats.equipped.includes(id)) {
                      stats.equipped.push(id);
                  }

                  showNotification(`SUCCESSFULLY CRAFTED ${recipe.name}!`, "#3b82f6");

                  updateUI();
                  renderCrafting();
                  save();
              }

              function usePotion(id) {
                 const pot = potions.find(p => p.id === id);
                 const now = Date.now();

                 if (pot.requiredRolls && stats.totalRolls < pot.requiredRolls) {
                     showNotification(`LOCKED: ${pot.requiredRolls.toLocaleString()} ROLLS REQUIRED`, "#ef4444");
                     return;
                 }

                 if (pot.percentLuck) {
                    stats.timedPotion = {
                        percentLuck: pot.percentLuck,
                        expiresAt: Date.now() + (pot.duration * 1000)
                    };
                    stats.cooldowns[id] = Date.now() + (pot.cooldown * 1000);
                    updateUI();
                    renderPotions();
                    save();
                    return;
                 }

                 if (stats.cooldowns[id] && now < stats.cooldowns[id]) {
                     return;
                 }

                 stats.activePotion = pot;
                 stats.cooldowns[id] = now + (pot.cooldown * 1000);

                 updateUI();
                 renderPotions();
                 save();
