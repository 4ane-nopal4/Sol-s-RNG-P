              // System Biome Data
              const biomes = [
                { name: "Starfall", chance: 7500, duration: 650, color: "#002dc2ff" },
                { name: "Null", chance: 10100, duration: 99, color: "#565656ff" },
                { name: "Corruption", chance: 9000, duration: 650, color: "#7c13deff" },
                { name: "Hell", chance: 6666, duration: 666, color: "#ef4444" },
                { name: "Heaven", chance: 3000, duration: 240, color: "#fcea24ff" },
                { name: "Sandstorm", chance: 3000, duration: 650, color: "#eab308" },
                { name: "Rainy", chance: 750, duration: 120, color: "#3b82f6" },
                { name: "Snowy", chance: 600, duration: 120, color: "#e0f2fe" },
                { name: "Windy", chance: 500, duration: 120, color: "#a7f3d0" },
                { name: "Glitched", chance: 5100000, duration: 164, color: "#cfcfcfff" },
                { name: "Dreamspace", chance: 3500000, duration: 192, color: "#ff00e1ff" },
                { name: "Singularity", chance: 75000, duration: 1200, color: "#ff7300ff" },
              ];

              let currentBiome = {
                name: "Normal",
                color: "#9ca3af",
                expiresAt: 0
              };

// DAY & NIGHT SYSTEM
const DAY_NIGHT_DURATION = 150; // 150 detik per fase

let currentDayNight = {
    name: "Day",
    startedAt: Date.now()
};

function updateDayNightSystem() {
    const display = document.getElementById("day-night-display");
    if (!display) return;

    const now = Date.now();

    // Menghitung waktu yang telah berlalu sejak sistem dimulai
    const elapsed = Math.floor(
        (now - currentDayNight.startedAt) / 1000
    );

    // Menghitung fase berdasarkan siklus 300 detik
    const cycleTime = elapsed % (DAY_NIGHT_DURATION * 2);

    if (cycleTime < DAY_NIGHT_DURATION) {
        currentDayNight.name = "Day";

        const remaining = DAY_NIGHT_DURATION - cycleTime;

        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;

        display.innerText =
            `DAY [ ${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")} ]`;

        display.style.color = "#facc15";
    } else {
        currentDayNight.name = "Night";

        const remaining =
            (DAY_NIGHT_DURATION * 2) - cycleTime;

        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;

        display.innerText =
            `NIGHT [ ${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")} ]`;

        display.style.color = "#0d0070ff";
    }
}

              function updateBiomeSystem() {
                const biomeEl = document.getElementById('biome-display');
                if (!biomeEl) return;

                const now = Date.now();

                if (currentBiome.name === "Normal") {
                  biomeEl.innerText = "[ Normal ]";
                  biomeEl.style.color = currentBiome.color;

                  const sortedBiomes = [...biomes].sort((a, b) => b.chance - a.chance);
                  for (const b of sortedBiomes) {
                    if (Math.random() < (1 / b.chance)) {
                      currentBiome = {
                        name: b.name,
                        color: b.color,
                        expiresAt: now + (b.duration * 3000)
                      };

            const specialBiomeMessages = {
                "Glitched": "Unexpected error occurred. [Code 404]",
                "Dreamspace": "You begin to feel sleepy...",
                "Singularity": "The Singularity pulls in everything, including you..."
            };

            const message = specialBiomeMessages[b.name]
                || `BIOME CHANGED TO: [ ${b.name.toUpperCase()} ]`;

            showNotification(message, b.color);

                      break;
                    }
                  }
                } else {
                  const remaining = Math.ceil((currentBiome.expiresAt - now) / 1000);

                  if (remaining <= 0) {
                    showNotification("BIOME RETURNED TO NORMAL", "#9ca3af");
                    currentBiome = {
                      name: "Normal",
                      color: "#9ca3af",
                      expiresAt: 0
                    };
                    biomeEl.innerText = "[ Normal ]";
                    biomeEl.style.color = currentBiome.color;
                  } else {
                    // Hanya menampilkan nama biome tanpa tulisan detik
                    biomeEl.innerText = `[ ${currentBiome.name} ]`;
                    biomeEl.style.color = currentBiome.color;
                  }
                }
              }

              function formatDate(timestamp) {
                  const d = new Date(timestamp);
                  const day = String(d.getDate()).padStart(2, '0');
                  const month = String(d.getMonth() + 1).padStart(2, '0');
                  const year = d.getFullYear();
                  const hours = String(d.getHours()).padStart(2, '0');
                  const minutes = String(d.getMinutes()).padStart(2, '0');
                  return `${day}/${month}/${year} ${hours}:${minutes}`;
              }

