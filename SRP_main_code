<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sol's RNG</title>

    <link
    rel="icon"
    href="https://files.catbox.moe/ttfu7s.webp"
    type="image/webp"
    />

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
             @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');

             body {
                 font-family: 'Inter', sans-serif;
                 background-color: #87CEEB ;
                 color: white;
                 overflow: hidden;
                 height: 100vh;
                 margin: 0;
                 user-select: none;
             }

             .aura-text {
                 text-shadow: 0 0 20px currentColor;
                 transition: all 0.3s ease;
             }

             .roll-btn {
                 background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
                 box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
             }

             .roll-btn:disabled {
                 background: #333;
                 box-shadow: none;
                 cursor: not-allowed;
                 opacity: 0.5;
             }

             .vignette {
                 position: fixed;
                 top: 0; left: 0; width: 100%; height: 100%;
                 background: radial-gradient(circle, transparent 30%, rgba(0,0,0,0.8) 100%);
                 pointer-events: none;
             }

             @keyframes float {
                 0% { transform: translateY(0px); }
                 50% { transform: translateY(-15px); }
                 100% { transform: translateY(0px); }
             }

             .floating {
                 animation: float 3s ease-in-out infinite;
             }

             #background-aura {
                 position: fixed;
                 top: 0; left: 0; width: 100%; height: 100%;
                 z-index: -1;
                 opacity: 0.2;
                 transition: background 1s ease;
             }

             .shake {
                 animation: shake 0.6s cubic-bezier(.36,.07,.19,.97) both;
             }

             @keyframes shake {
                 10%, 90% { transform: translate3d(-2px, 0, 0); }
                 20%, 80% { transform: translate3d(4px, 0, 0); }
                 30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
                 40%, 60% { transform: translate3d(6px, 0, 0); }
             }

             .particle {
                 position: absolute;
                 pointer-events: none;
                 border-radius: 50%;
                 z-index: 5;
             }

             @keyframes particle-fade {
                 to {
                     transform: translate(var(--tw-x), var(--tw-y)) scale(0);
                     opacity: 0;
                 }
             }

             .custom-scrollbar::-webkit-scrollbar { width: 6px; }
             .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
             .custom-scrollbar::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }

             .cooldown-overlay {
                 position: absolute;
                 bottom: 0;
                 left: 0;
                 width: 100%;
                 background: rgba(255,255,255,0.1);
                 transition: height 0.1s linear;
                 pointer-events: none;
             }

             .btn-equipped {
                 border: 2px solid #3b82f6;
                 background: rgba(59, 130, 246, 0.2) !important;
             }

      #pixel-background {
         position: fixed;
         inset: 0;
         overflow: hidden;
         z-index: -20;
         background: #87CEEB;
      }

      #pixel-background::before {
         content: "";
         position: absolute;
         inset: 0;
         background-image:
             radial-gradient(#00ffff88 1px, transparent 1px);
         background-size: 18px 18px;
         opacity: 0.25;
      }

      .ground {
         position: absolute;
         bottom: 0;
         width: 100%;
         height: 140px;
         background: #008000;
         border-top: 8px solid #006400;
      }

      .tree {
         position: absolute;
         bottom: 120px;
         width: 140px;
         height: 260px;
      }

      .trunk {
         position: absolute;
         bottom: 0;
         left: 50%;
         transform: translateX(-50%);
         width: 36px;
         height: 120px;
         background: #8B4513;
      }

      .leaves {
         position: absolute;
         top: 0;
         left: 50%;
         transform: translateX(-50%);
         width: 140px;
         height: 140px;
         background: #228B22;
         clip-path: polygon(
             20% 0%,
             80% 0%,
             80% 20%,
             100% 20%,
             100% 80%,
             80% 80%,
             80% 100%,
             20% 100%,
             20% 80%,
             0% 80%,
             0% 20%,
             20% 20%
         );
         box-shadow: 0 0 25px #008000;
      }

      .tree-left { left: 40px; }
      .tree-right { right: 40px; }
    </style>
