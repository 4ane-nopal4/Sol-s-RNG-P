                              <h3 class="font-black text-purple-400 text-sm italic tracking-widest uppercase">${pot.name}</h3>
                              <p class="text-[10px] font-bold text-gray-400 mt-1">
                                ${pot.percentLuck ? `+${pot.percentLuck * 100}\% LUCK FOR${pot.duration}s` : `+${pot.luck.toLocaleString()} LUCK FOR NEXT ROLL`}
                              </p>
                              ${pot.requiredRolls ? `<p class="text-[8px] text-yellow-400 mt-2 uppercase font-black">UNLOCK: ${pot.requiredRolls.toLocaleString()} ROLLS</p>` : ''}
                          </div>
                          <button id="btn-pot-${pot.id}" onclick="usePotion('${pot.id}')" class="relative z-10 w-full bg-purple-600 hover:bg-purple-500 py-2 rounded font-black text-[10px] text-white uppercase mt-4 transition-all">
                              Consume
                          </button>
                      `;
                      list.appendChild(div);
                  });
              }

              function renderInventory() {
                  const list = document.getElementById('inventory-list');
                  list.innerHTML = '';
                  const keys = Object.keys(stats.inventory).filter(k => stats.inventory[k].count > 0).sort((a, b) => stats.inventory[b].chance - stats.inventory[a].chance);

                  if (keys.length === 0) {
                      list.innerHTML = '<div class="col-span-full text-center text-gray-500 italic py-20 uppercase tracking-widest text-sm font-black">No Collections Yet...</div>';
                      return;
                  }

                  keys.forEach(name => {
                      const item = stats.inventory[name];
                      const div = document.createElement('div');
                      div.className = 'bg-white/5 p-4 rounded-xl border border-white/5 flex flex-col justify-between hover:bg-white/10 transition-all';
                      div.innerHTML = `
                          <div>
                              <div class="text-[8px] opacity-70 font-black tracking-[0.2em] uppercase">${item.label}</div>
                              <div class="text-xs font-black truncate uppercase mt-1" style="color:${item.color}">
                                  ${name}
                              </div>
                          </div>

                          <div class="flex justify-between items-center mt-4">
                              <span class="text-[8px] text-gray-500 font-bold italic">
                                  1/${item.chance.toLocaleString()}
                              </span>
                              <span class="text-[10px] font-black bg-white/10 px-2 py-0.5 rounded">
                                  x${item.count}
                              </span>
                          </div>

                          <button
                              onclick="deleteAura('${name.replace(/'/g, "\\'")}')"
                              class="mt-3 w-full bg-red-600 hover:bg-red-500 py-1 rounded text-[10px] font-black uppercase transition">
                              Delete
                          </button>
                      `;
                      list.appendChild(div);
                  });
              }

              function openModal(id) {
                  document.getElementById(id).classList.remove('hidden');
                  if (id === 'inventory-modal') renderInventory();
                  if (id === 'crafting-modal') renderCrafting();
                  if (id === 'potions-modal') renderPotions();
              }

              function closeModal(id) {
                  document.getElementById(id).classList.add('hidden');
              }

              function toggleAutoRoll() {
                  stats.autoRoll = document.getElementById('auto-roll').checked;
                  const dot = document.getElementById('auto-toggle-dot');
                  const bg = document.getElementById('auto-toggle-bg');

                  if (stats.autoRoll) {
                      dot.classList.add('translate-x-7');
                      bg.classList.add('bg-blue-600');
                      clearInterval(autoRollInterval);
                      autoRollInterval = setInterval(roll, 444);
                  } else {
                      dot.classList.remove('translate-x-7');
                      bg.classList.remove('bg-blue-600');
                      clearInterval(autoRollInterval);
                  }
              }

              function showNotification(text, color) {
                  const container = document.getElementById('notif-container');
                  const n = document.createElement('div');
                  n.className = 'px-5 py-3 bg-black/90 border-r-4 rounded shadow-2xl transform translate-x-full transition-all duration-300 text-[10px] font-black uppercase tracking-widest flex items-center gap-3';
                  n.style.borderRightColor = color;
                  n.innerHTML = `<div class="w-2 h-2 rounded-full" style="background-color: ${color}"></div>${text}`;
                  container.appendChild(n);
                  setTimeout(() => n.classList.remove('translate-x-full'), 10);
                  setTimeout(() => {
                      n.classList.add('opacity-0');
                      setTimeout(() => n.remove(), 500);
                  }, 3000);
              }

              init();
    </script>
  </body>
</html>
