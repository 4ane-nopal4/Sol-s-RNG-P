              function playVideoCutscene(src, auraChance = Infinity, callback = null) {
                 stopAllMedia();
                 if (!stats.settings.cutsceneEnabled) return false;
                 if (auraChance < stats.settings.cutsceneThreshold) return false;

                 const video = document.getElementById('cutscene-video');
                 const bgMusic = document.getElementById('bg-music');

                 autoRollPaused = true;
                 bgMusic.pause();
                 video.pause();
                 video.currentTime = 0;
                 video.src = src;
                 video.style.display = "block";

                 const playPromise = video.play();
                 if (playPromise !== undefined) {
                     playPromise.catch(err => { console.log("Autoplay blocked:", err); });
                 }

                 video.onended = () => {
                     video.style.display = "none";
                     video.pause();
                     video.currentTime = 0;
                     bgMusic.play();
                     setTimeout(() => {
                         autoRollPaused = false;
                         if (callback) callback();
                     }, 300);
                 };

                 return true;
              }

