              function calculateTotalLuck() {
                 let deviceBonus = 0;
                 stats.equipped.forEach(id => {
                     const recipe = craftingRecipes.find(r => r.id === id);
                     if (recipe) deviceBonus += recipe.bonus;
                 });

                 let total = stats.baseLuck + deviceBonus;
                 if (stats.bonusRoll) { total *= 2; }
                 if (stats.activePotion) { total += stats.activePotion.luck; }
                 if (stats.timedPotion) {
                     if (Date.now() < stats.timedPotion.expiresAt) {
                         total *= (1 + stats.timedPotion.percentLuck);
                     } else {
                         stats.timedPotion = null;
                     }
                 }
                 return total;
              }

